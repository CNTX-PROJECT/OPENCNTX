{
  "format": "opencntx-visual-tokens",
  "format_version": 1,
  "foundation": {
    "breakpoint-wide": "64rem",
    "content-measure": "68rem",
    "font-mono": "Consolas, ui-monospace, SFMono-Regular, monospace",
    "font-sans": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "line-body": "1.65",
    "line-heading": "1.12",
    "motion-fast": "140ms",
    "motion-standard": "220ms",
    "radius-control": "0.65rem",
    "radius-panel": "1rem",
    "shadow-panel": "0 1.25rem 3rem rgb(15 23 42 / 0.12)",
    "space-1": "0.25rem",
    "space-2": "0.5rem",
    "space-3": "0.75rem",
    "space-4": "1rem",
    "space-5": "1.5rem",
    "space-6": "2rem",
    "space-7": "3rem",
    "space-8": "4.5rem",
    "type-body": "1rem",
    "type-display": "clamp(2.5rem, 7vw, 5.5rem)",
    "type-h1": "clamp(2rem, 5vw, 4rem)",
    "type-h2": "clamp(1.5rem, 3vw, 2.5rem)",
    "type-small": "0.875rem"
  },
  "light": {
    "accent": "#0891B2",
    "blocked": "#9F1239",
    "border": "#CBD5E1",
    "brand": "#DDA0DD",
    "brand-ink": "#0B1020",
    "canvas": "#F8FAFC",
    "danger": "#B42318",
    "focus": "#0891B2",
    "success": "#047857",
    "surface": "#FFFFFF",
    "surface-soft": "#F1F5F9",
    "text": "#0F172A",
    "text-muted": "#475569",
    "warning": "#92400E"
  },
  "dark": {
    "accent": "#22D3EE",
    "blocked": "#FDA4AF",
    "border": "#334155",
    "brand": "#DDA0DD",
    "brand-ink": "#0B1020",
    "canvas": "#0B1020",
    "danger": "#FCA5A5",
    "focus": "#22D3EE",
    "success": "#34D399",
    "surface": "#111827",
    "surface-soft": "#172033",
    "text": "#F8FAFC",
    "text-muted": "#CBD5E1",
    "warning": "#FCD34D"
  },
  "high_contrast": {
    "border": "currentColor",
    "focus": "currentColor",
    "shadow-panel": "none"
  },
  "component_states": [
    "ACTIVE",
    "BLOCKED",
    "DEFAULT",
    "DISABLED",
    "EMPTY",
    "ERROR",
    "FOCUS_VISIBLE",
    "HOVER",
    "LOADING",
    "SUCCESS",
    "WARNING"
  ]
}
