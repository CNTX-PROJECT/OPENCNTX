{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencntx.dev/schemas/legacy-transaction-export-v1.schema.json",
  "title": "OPENCNTX legacy transaction export v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "source_root", "readiness_digest", "entries", "source_completed_tree_digest", "source_rewritten", "manifest_digest"],
  "properties": {
    "format": {"const": "opencntx-legacy-transaction-export"},
    "format_version": {"const": 1},
    "source_root": {"type": "string"},
    "readiness_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "source_completed_tree_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_rewritten": {"const": false},
    "manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
