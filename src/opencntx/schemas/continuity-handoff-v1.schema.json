{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencntx.dev/schemas/continuity-handoff-v1.schema.json",
  "title": "OPENCNTX continuity handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "project_id", "roadmap_id", "assignment_id", "outcome", "decisions", "result", "changed_paths", "evidence", "evidence_explanation", "risks", "dependencies", "next_assignment", "receipt_digest", "previous_event_head", "handoff_digest"],
  "properties": {
    "format": {"const": "opencntx-continuity-handoff"},
    "format_version": {"const": 1},
    "project_id": {"type": "string"},
    "roadmap_id": {"type": "string"},
    "assignment_id": {"type": "string"},
    "outcome": {"const": "PASS"},
    "decisions": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "result": {"type": "string", "minLength": 1, "maxLength": 2000},
    "changed_paths": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "evidence_explanation": {"type": "string", "minLength": 1, "maxLength": 2000},
    "risks": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "dependencies": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}},
    "next_assignment": {"type": ["string", "null"]},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_event_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "handoff_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
