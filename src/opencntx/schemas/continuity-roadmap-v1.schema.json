{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencntx.dev/schemas/continuity-roadmap-v1.schema.json",
  "title": "OPENCNTX continuity roadmap v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "project_id", "roadmap_id", "title", "assignments"],
  "properties": {
    "format": {"const": "opencntx-continuity-roadmap"},
    "format_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,79}$"},
    "roadmap_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,79}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "detail", "depends_on", "touches", "conflict", "migration", "definition_of_done"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,79}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
          "depends_on": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}},
          "touches": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string"}},
          "conflict": {"enum": ["NO_CONFLICT", "EXTEND", "SUPERSEDE", "MIGRATE", "REMOVE"]},
          "migration": {"type": "string", "maxLength": 500},
          "definition_of_done": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
