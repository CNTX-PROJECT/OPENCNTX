{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencntx.dev/schemas/continuity-state-v2.schema.json",
  "title": "OPENCNTX classified continuity state v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "project_id", "roadmap_id", "roadmap_digest", "status", "current_assignment", "completed", "recovery_rounds", "failure_fingerprints", "event_count", "event_head", "skipped", "required_outcomes_complete", "state_digest"],
  "properties": {
    "format": {"const": "opencntx-continuity-store"},
    "format_version": {"const": 2},
    "project_id": {"type": "string"},
    "roadmap_id": {"type": "string"},
    "roadmap_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["READY", "RUNNING", "RECOVERY_REQUIRED", "BLOCKED", "COMPLETE"]},
    "current_assignment": {"type": ["string", "null"]},
    "completed": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "recovery_rounds": {"type": "integer", "minimum": 0, "maximum": 4},
    "failure_fingerprints": {"type": "array", "maxItems": 4, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "event_count": {"type": "integer", "minimum": 1},
    "event_head": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skipped": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "required_outcomes_complete": {"type": "boolean"},
    "state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
