{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencntx.dev/schemas/human-output-v1.schema.json",
  "title": "OPENCNTX human output v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "language", "profile", "summary", "uncertainty", "duration", "roadmap", "current_assignment", "assignment_status", "thereafter", "next_assignment", "next_action_state", "exact_human_action", "metrics", "required_capability", "reasoning_level", "labels", "technical_details", "state_digest", "evidence_digest", "execution_capsule_digest", "decision_digest", "authority_changed", "output_digest"],
  "properties": {
    "format": {"const": "opencntx-human-output"},
    "format_version": {"const": 1},
    "language": {"type": "string"},
    "profile": {"enum": ["HUMAN_SIMPLE", "TECHNICAL_DETAILED"]},
    "summary": {"type": "string"},
    "uncertainty": {"type": ["string", "null"]},
    "duration": {"type": ["string", "null"]},
    "roadmap": {"type": "string"},
    "current_assignment": {"type": ["string", "null"]},
    "assignment_status": {"type": ["string", "null"]},
    "thereafter": {"type": ["string", "null"]},
    "next_assignment": {"type": ["string", "null"]},
    "next_action_state": {"enum": ["CONTINUE_AUTOMATICALLY", "OWNER_DECISION_REQUIRED", "EXTERNAL_ACTION_REQUIRED", "BLOCKED", "NO_FURTHER_ACTION"]},
    "exact_human_action": {"type": ["string", "null"]},
    "metrics": {"type": "object"},
    "required_capability": {"type": "string"},
    "reasoning_level": {"type": "string"},
    "labels": {"type": "object"},
    "technical_details": {"type": "array", "items": {"type": "string"}},
    "state_digest": {"type": ["string", "null"]},
    "evidence_digest": {"type": ["string", "null"]},
    "execution_capsule_digest": {"type": ["string", "null"]},
    "decision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_changed": {"const": false},
    "output_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
