{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencntx.dev/schemas/transactional-update-plan-v1.schema.json",
  "title": "OPENCNTX transactional update plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "update_root", "from_version", "to_version", "components", "compatibility_target", "compatibility_matrix_digest", "changelog", "risks", "required_bytes", "available_bytes", "writes_performed", "plan_id", "backup_path", "rollback_boundary", "plan_digest"],
  "properties": {
    "format": {"const": "opencntx-transactional-update-plan"},
    "format_version": {"const": 1},
    "update_root": {"type": "string"},
    "from_version": {"type": "string"},
    "to_version": {"type": "string"},
    "components": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object"}},
    "compatibility_target": {"type": "object"},
    "compatibility_matrix_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "changelog": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "required_bytes": {"type": "integer", "minimum": 0},
    "available_bytes": {"type": "integer", "minimum": 0},
    "writes_performed": {"const": false},
    "plan_id": {"type": "string"},
    "backup_path": {"type": "string"},
    "rollback_boundary": {"type": "string"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
