{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencntx.dev/schemas/footer-host-envelope-v2.schema.json",
  "title": "OPENCNTX context-bound partial footer telemetry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_generation",
    "envelope_digest",
    "format",
    "format_version",
    "metrics",
    "proposal",
    "session_id",
    "source_digest"
  ],
  "properties": {
    "format": {
      "const": "ocx-footer-host-envelope-v2"
    },
    "format_version": {
      "const": 2
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "context_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proposal": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 200
    },
    "envelope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chat_bytes",
        "total_tokens",
        "model",
        "reasoning"
      ],
      "properties": {
        "chat_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "measured_at"
          ],
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "measured_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "source": {
                    "type": "null"
                  },
                  "measured_at": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "measured_at": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "total_tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "measured_at"
          ],
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "measured_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "source": {
                    "type": "null"
                  },
                  "measured_at": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "measured_at": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "measured_at"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 200
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "measured_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "source": {
                    "type": "null"
                  },
                  "measured_at": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "measured_at": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        },
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source",
            "measured_at"
          ],
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 200
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256
            },
            "measured_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "value": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "source": {
                    "type": "null"
                  },
                  "measured_at": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "measured_at": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
