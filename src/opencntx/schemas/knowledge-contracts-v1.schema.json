{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CNTX-PROJECT/OPENCNTX/schema/knowledge-contracts-v1",
  "title": "OPENCNTX 1.8.0 knowledge contracts",
  "description": "Closed local metadata envelopes for source nodes, typed links, search results, technique memory, adoption, provider-neutral footers and session-bound host footer telemetry.",
  "oneOf": [
    { "$ref": "#/$defs/sourceNode" },
    { "$ref": "#/$defs/linkManifest" },
    { "$ref": "#/$defs/searchResult" },
    { "$ref": "#/$defs/techniqueCard" },
    { "$ref": "#/$defs/adoptionManifest" },
    { "$ref": "#/$defs/footerContract" },
    { "$ref": "#/$defs/hostFooterEnvelope" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "base": {
      "type": "object",
      "required": ["format", "format_version"],
      "properties": { "format": { "type": "string" }, "format_version": { "const": 1 } },
      "additionalProperties": true
    },
    "sourceNode": {
      "$ref": "#/$defs/base",
      "properties": {
        "format": { "const": "ocx-source-node-v1" },
        "ocx_id": { "type": "string" },
        "root_id": { "type": "string" },
        "parent_id": { "type": ["string", "null"] },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)" },
        "depth": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 0 },
        "privacy": { "enum": ["PUBLIC", "PRIVATE", "RESTRICTED", "QUARANTINED"] },
        "freshness": { "type": "string" }
      },
      "required": ["ocx_id", "root_id", "parent_id", "path", "depth", "digest", "bytes", "privacy", "freshness"]
    },
    "linkManifest": {
      "$ref": "#/$defs/base",
      "properties": {
        "format": { "const": "ocx-link-manifest-v1" },
        "source_id": { "type": "string" },
        "target_id": { "type": ["string", "null"] },
        "target_path": { "type": "string" },
        "relation": { "enum": ["contains", "requires", "supports", "history_of", "supersedes", "verify_live", "references"] },
        "load_mode": { "enum": ["required", "on_demand"] },
        "source_digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["source_id", "target_id", "target_path", "relation", "load_mode", "source_digest"]
    },
    "searchResult": {
      "$ref": "#/$defs/base",
      "properties": {
        "format": { "const": "ocx-search-result-v1" },
        "index_digest": { "$ref": "#/$defs/digest" },
        "query": { "type": "string" },
        "results": { "type": "array" },
        "loaded_bytes": { "type": "integer", "minimum": 0 },
        "referenced_bytes": { "type": "integer", "minimum": 0 },
        "skipped_bytes": { "type": "integer", "minimum": 0 }
      },
      "required": ["index_digest", "query", "results", "loaded_bytes", "referenced_bytes", "skipped_bytes"]
    },
    "techniqueCard": {
      "$ref": "#/$defs/base",
      "properties": {
        "format": { "const": "ocx-technique-card-v1" },
        "technique_id": { "type": "string" },
        "name": { "type": "string" },
        "trigger": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } },
        "source_digests": { "type": "array", "items": { "$ref": "#/$defs/digest" } },
        "verification_state": { "enum": ["PROVEN", "STALE", "PROPOSED"] },
        "card_digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["technique_id", "name", "trigger", "steps", "source_digests", "verification_state", "card_digest"]
    },
    "adoptionManifest": {
      "$ref": "#/$defs/base",
      "properties": {
        "format": { "const": "ocx-project-adoption-v1" },
        "project_id": { "type": "string" },
        "ownership": { "const": "EXISTING_LOCAL" },
        "state": { "const": "DISCOVERED" },
        "proposed_action": { "const": "BIND_READ_ONLY" },
        "records": { "type": "array" },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["READY", "BLOCKED"] },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "code": { "type": "string", "minLength": 1 },
                  "path": { "type": "string" },
                  "detail": { "type": "string", "minLength": 1 }
                },
                "required": ["code", "path", "detail"]
              }
            },
            "records": { "type": "integer", "minimum": 0 },
            "links": { "type": "integer", "minimum": 0 }
          },
          "required": ["status", "findings", "records", "links"]
        },
        "source_tree_digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["project_id", "ownership", "state", "proposed_action", "records", "audit", "source_tree_digest", "manifest_digest"]
    },
    "footerContract": {
      "$ref": "#/$defs/base",
      "properties": {
        "format": { "const": "ocx-footer-contract-v1" },
        "task_note": { "type": "string" },
        "status": { "type": "string" },
        "now": { "type": "string" },
        "thereafter": { "type": "string" },
        "chat": { "type": "string" },
        "tokens": { "type": "string" },
        "model": { "type": "string" },
        "proposal": { "type": "string" },
        "profile": { "enum": ["commonmark", "portable", "plain", "exact"] },
        "contract_digest": { "$ref": "#/$defs/digest" }
      },
      "required": ["task_note", "status", "now", "thereafter", "chat", "tokens", "model", "proposal", "profile", "contract_digest"]
    },
    "hostFooterEnvelope": {
      "type": "object",
      "properties": {
        "format": { "const": "ocx-footer-host-envelope-v1" },
        "format_version": { "const": 1 },
        "adapter": { "type": "string", "minLength": 1, "maxLength": 200 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "status": { "enum": ["OK", "UNAVAILABLE"] },
        "chat_megabytes": { "type": ["number", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "model": { "type": ["string", "null"], "maxLength": 200 },
        "proposal": { "type": ["string", "null"], "maxLength": 200 },
        "source_digest": { "$ref": "#/$defs/digest" },
        "envelope_digest": { "$ref": "#/$defs/digest" }
      },
      "required": [
        "format",
        "format_version",
        "adapter",
        "session_id",
        "source_session_id",
        "status",
        "chat_megabytes",
        "total_tokens",
        "model",
        "proposal",
        "source_digest",
        "envelope_digest"
      ],
      "additionalProperties": false
    }
  }
}
