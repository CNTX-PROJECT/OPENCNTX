{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "request",
    "outcome_id",
    "query",
    "source_bytes",
    "denominator",
    "inspected_ids",
    "missing_fields",
    "finding_ids",
    "status",
    "safety",
    "usability",
    "acceptance",
    "claims",
    "report_digest"
  ],
  "properties": {
    "format": {
      "const": "opencntx-outcome-report"
    },
    "format_version": {
      "type": "integer",
      "const": 2
    },
    "request": {
      "$ref": "goal-binding-v2.schema.json#/properties/request"
    },
    "outcome_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_id",
        "source_path",
        "source_sha256",
        "required_fields",
        "match_field",
        "match_value",
        "claim_key",
        "match_conclusion",
        "zero_conclusion"
      ],
      "properties": {
        "outcome_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "match_field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "match_value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "claim_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "match_conclusion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "zero_conclusion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "source_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "denominator": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "inspected_ids": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "missing_fields": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "finding_ids": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "status": {
      "enum": [
        "DELIVERED",
        "PARTIAL",
        "BLOCKED"
      ]
    },
    "safety": {
      "const": "SAFE_READ_ONLY"
    },
    "usability": {
      "enum": [
        "USABLE",
        "INSUFFICIENT"
      ]
    },
    "acceptance": {
      "const": "UNKNOWN"
    },
    "claims": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "report_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
