{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencntx.dev/schemas/session-handoff-v1.schema.json",
  "title": "OPENCNTX session handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "handoff_id", "project_id", "roadmap_id", "roadmap_revision", "source_part", "target_part", "current_assignment", "current_internal_task", "assignment_status", "next_internal_action", "next_owner_gate", "authority_digest", "scope", "exclusions", "recovery_round", "rollback_boundary", "evidence_digest", "evidence_objects", "state_digest", "execution_capsule_digest", "provider_capabilities", "target_creation", "continuation_action", "handoff_digest"],
  "properties": {
    "format": {"const": "opencntx-session-handoff"},
    "format_version": {"const": 1},
    "handoff_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{0,79}$"},
    "project_id": {"type": "string"},
    "roadmap_id": {"type": "string"},
    "roadmap_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_part": {"type": "string"},
    "target_part": {"type": "string"},
    "current_assignment": {"type": ["string", "null"]},
    "current_internal_task": {"type": ["string", "null"]},
    "assignment_status": {"enum": ["ACTIVE", "RECOVERY_REQUIRED", "BLOCKED", "COMPLETED"]},
    "next_internal_action": {"type": ["string", "null"]},
    "next_owner_gate": {"type": "string"},
    "authority_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "exclusions": {"type": "array", "uniqueItems": true, "maxItems": 20, "items": {"type": "string"}},
    "recovery_round": {"type": "integer", "minimum": 0, "maximum": 3},
    "rollback_boundary": {"type": "string"},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_objects": {"type": "array", "maxItems": 50, "items": {"type": "object"}},
    "state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_capsule_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_capabilities": {"type": "object"},
    "target_creation": {"enum": ["CREATE_ONE_TARGET", "COPY_ACTION_REQUIRED"]},
    "continuation_action": {"type": ["string", "null"]},
    "handoff_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
