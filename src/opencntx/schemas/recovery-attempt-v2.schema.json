{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencntx.dev/schemas/recovery-attempt-v2.schema.json",
  "title": "OPENCNTX evidence-bound recovery attempt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "assignment_id", "dependency_class", "stage", "attempt_number", "failure_layer", "reason", "evidence_digest", "scope_fingerprint", "approach_fingerprint", "chain_coverage", "prior_failure_digests", "global_analysis_digest", "previous_record_digest", "authority_changed", "record_digest"],
  "properties": {
    "format": {"const": "opencntx-recovery-attempt"},
    "format_version": {"const": 2},
    "assignment_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "dependency_class": {"enum": ["CHAIN", "STANDALONE"]},
    "stage": {"enum": ["STANDARD_ATTEMPT_1", "STANDARD_RETRY_2", "GLOBAL_RECOVERY_1", "GLOBAL_RECOVERY_2"]},
    "attempt_number": {"type": "integer", "minimum": 1, "maximum": 4},
    "failure_layer": {"enum": ["PRODUCT", "TEST", "PLATFORM", "DATA", "DEPENDENCY", "AUTHORITY", "EXTERNAL_SERVICE", "CONTROL_PLANE"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approach_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chain_coverage": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "prior_failure_digests": {"type": "array", "maxItems": 3, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "global_analysis_digest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "previous_record_digest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "authority_changed": {"const": false},
    "record_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
