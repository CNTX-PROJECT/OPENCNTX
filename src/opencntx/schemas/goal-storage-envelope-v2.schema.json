{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "goal-storage-envelope-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "legacy_roadmap_base64",
    "legacy_sha256",
    "envelope_digest"
  ],
  "properties": {
    "format": {
      "const": "opencntx-goal-storage-envelope"
    },
    "format_version": {
      "const": 2,
      "type": "integer"
    },
    "legacy_roadmap_base64": {
      "type": "string",
      "contentEncoding": "base64"
    },
    "legacy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "envelope_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
