{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencntx.dev/schemas/combo-comparison-v1.schema.json",
  "title": "OPENCNTX pre-start combo comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "format_version", "roadmap_id", "combo_digest", "status", "missing_references", "unresolved_conflicts", "authority_granted", "flow_started", "comparison_digest"],
  "properties": {
    "format": {"const": "opencntx-combo-comparison"},
    "format_version": {"const": 1},
    "roadmap_id": {"type": "string"},
    "combo_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["CLEAR", "RECONCILE_REQUIRED", "BLOCKED"]},
    "missing_references": {"type": "array", "items": {"type": "string"}},
    "unresolved_conflicts": {"type": "array", "items": {"type": "string"}},
    "authority_granted": {"const": false},
    "flow_started": {"const": false},
    "comparison_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
