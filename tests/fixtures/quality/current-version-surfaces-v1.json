{
  "format": "opencntx-current-version-surfaces",
  "format_version": 1,
  "surfaces": [
    {
      "path": "src/opencntx/__init__.py",
      "patterns": [
        "__version__ = \"{version}\""
      ],
      "purpose": "Current published identity, not historical certification",
      "version_source": "package"
    },
    {
      "path": "README.md",
      "patterns": [
        "Download v{version}"
      ],
      "purpose": "Current published identity, not historical certification",
      "version_source": "published"
    },
    {
      "path": "docs/README.md",
      "patterns": [
        "Current published package: \\*\\*{version}"
      ],
      "purpose": "Current published identity, not historical certification",
      "version_source": "published"
    },
    {
      "path": "docs/releases.md",
      "patterns": [
        "Published package: v{version}",
        "opencntx-{version}-py3-none-any.whl"
      ],
      "purpose": "Current published identity, not historical certification",
      "version_source": "published"
    },
    {
      "path": "docs/roadmap.md",
      "patterns": [
        "Current published release: \\*\\*v{version}"
      ],
      "purpose": "Current published identity, not historical certification",
      "version_source": "published"
    },
    {
      "path": "docs/install-and-update.md",
      "patterns": [
        "Install and update OPENCNTX {version}"
      ],
      "purpose": "Current published identity, not historical certification",
      "version_source": "published"
    },
    {
      "path": "site/index.html",
      "patterns": [
        "releases/tag/v{version}",
        "opencntx-{version}-py3-none-any.whl"
      ],
      "purpose": "Current published identity, not historical certification",
      "version_source": "published"
    },
    {
      "path": "docs/start-here.md",
      "patterns": [
        "instructions below target v{version}"
      ],
      "purpose": "Current published identity, not historical certification",
      "version_source": "published"
    },
    {
      "path": "docs/faq.md",
      "patterns": [
        "Current download: \\*\\*v{version}"
      ],
      "purpose": "Current published identity, not historical certification",
      "version_source": "published"
    },
    {
      "path": "docs/release-artifacts.md",
      "patterns": [
        "Current download: \\*\\*v{version}"
      ],
      "purpose": "Current published identity, not historical certification",
      "version_source": "published"
    },
    {
      "path": "docs/continuity.md",
